*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
.idea/
Carthage
.DS_Store
.ruby-version
.bundle/
.build/

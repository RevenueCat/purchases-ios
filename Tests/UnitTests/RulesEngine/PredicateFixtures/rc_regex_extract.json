{
  "fixtures": [
    {
      "id": "regex_extract_whole_match_by_default",
      "predicate": {"===": [{"rc.regexExtract": ["es-419", "[0-9]+"]}, "419"]},
      "variables": {},
      "expected": true
    },
    {
      "id": "regex_extract_first_match_only",
      "predicate": {"===": [{"rc.regexExtract": ["a1b2", "[0-9]"]}, "1"]},
      "variables": {},
      "expected": true
    },
    {
      "id": "regex_extract_capture_group",
      "description": "Motivating case: pull the language out of a locale",
      "predicate": {"===": [{"rc.regexExtract": ["es-419", "^([a-z]+)-", 1]}, "es"]},
      "variables": {},
      "expected": true
    },
    {
      "id": "regex_extract_group_zero_is_the_whole_match",
      "predicate": {"===": [{"rc.regexExtract": ["es-419", "^([a-z]+)-", 0]}, "es-"]},
      "variables": {},
      "expected": true
    },
    {
      "id": "regex_extract_second_group",
      "predicate": {"===": [{"rc.regexExtract": ["1.2.3", "^([0-9]+)\\.([0-9]+)", 2]}, "2"]},
      "variables": {},
      "expected": true
    },
    {
      "id": "regex_extract_no_match_is_null",
      "description": "Absence is an ordinary answer, so it is a value rather than an error",
      "predicate": {"==": [{"rc.regexExtract": ["abc", "[0-9]+"]}, null]},
      "variables": {},
      "expected": true
    },
    {
      "id": "regex_extract_unmatched_group_is_null",
      "description": "Group 1 of (a)|(b) takes no part in the match against b, so there is no text to return",
      "predicate": {"==": [{"rc.regexExtract": ["b", "(a)|(b)", 1]}, null]},
      "variables": {},
      "expected": true
    },
    {
      "id": "regex_extract_matched_group_of_an_alternation",
      "predicate": {"===": [{"rc.regexExtract": ["b", "(a)|(b)", 2]}, "b"]},
      "variables": {},
      "expected": true
    },
    {
      "id": "regex_extract_can_match_empty_text",
      "description": "An empty capture is a real answer and stays distinct from a null non-match",
      "predicate": {"===": [{"rc.regexExtract": ["ab", "a([0-9]*)b", 1]}, ""]},
      "variables": {},
      "expected": true
    },
    {
      "id": "regex_extract_empty_input_yields_the_empty_match",
      "description": "An empty input is still searched, so a pattern able to match nothing extracts the empty string rather than null",
      "predicate": {"===": [{"rc.regexExtract": ["", "a*"]}, ""]},
      "variables": {},
      "expected": true
    },
    {
      "id": "regex_extract_empty_input_has_no_match_for_a_pattern_needing_a_character",
      "predicate": {"==": [{"rc.regexExtract": ["", "a"]}, null]},
      "variables": {},
      "expected": true
    },
    {
      "id": "regex_extract_feeds_another_operator",
      "predicate": {
        "===": [
          {"rc.upper": {"rc.regexExtract": ["es-419", "^([a-z]+)", 1]}},
          "ES"
        ]
      },
      "variables": {},
      "expected": true
    },
    {
      "id": "regex_extract_group_the_pattern_does_not_have_is_type_error",
      "description": "Asking for a group that cannot exist is a lowering bug, unlike a group that simply did not participate",
      "predicate": {"rc.regexExtract": ["abc", "(a)", 2]},
      "variables": {},
      "expected": {"error": "typeMismatch", "operator": "rc.regexExtract"}
    },
    {
      "id": "regex_extract_group_beyond_the_integer_range_is_type_error",
      "description": "A group number too large to be an index is clamped rather than overflowing, and then fails as a group the pattern does not have",
      "predicate": {"rc.regexExtract": ["abc", "(a)", 9223372036854775807]},
      "variables": {},
      "expected": {"error": "typeMismatch", "operator": "rc.regexExtract"}
    },
    {
      "id": "regex_extract_whole_float_group_beyond_the_integer_range_is_type_error",
      "predicate": {"rc.regexExtract": ["abc", "(a)", 1e18]},
      "variables": {},
      "expected": {"error": "typeMismatch", "operator": "rc.regexExtract"}
    },
    {
      "id": "regex_extract_fractional_group_is_type_error",
      "predicate": {"rc.regexExtract": ["abc", "(a)", 1.5]},
      "variables": {},
      "expected": {"error": "typeMismatch", "operator": "rc.regexExtract"}
    },
    {
      "id": "regex_extract_negative_group_is_type_error",
      "predicate": {"rc.regexExtract": ["abc", "(a)", -1]},
      "variables": {},
      "expected": {"error": "typeMismatch", "operator": "rc.regexExtract"}
    },
    {
      "id": "regex_extract_non_numeric_group_is_type_error",
      "description": "No named groups yet: the third argument is a number, not a group name",
      "predicate": {"rc.regexExtract": ["abc", "(a)", "1"]},
      "variables": {},
      "expected": {"error": "typeMismatch", "operator": "rc.regexExtract"}
    },
    {
      "id": "regex_extract_uncompilable_pattern_is_type_error",
      "predicate": {"rc.regexExtract": ["abc", "("]},
      "variables": {},
      "expected": {"error": "typeMismatch", "operator": "rc.regexExtract"}
    },
    {
      "id": "regex_extract_non_string_input_is_type_error",
      "predicate": {"rc.regexExtract": [419, "[0-9]+"]},
      "variables": {},
      "expected": {"error": "typeMismatch", "operator": "rc.regexExtract"}
    },
    {
      "id": "regex_extract_missing_variable_fails_at_the_lookup",
      "predicate": {"rc.regexExtract": [{"var": "missing"}, "abc"]},
      "variables": {},
      "expected": {"error": "unresolvedVariable", "path": "missing"}
    },
    {
      "id": "regex_extract_missing_pattern_is_type_error",
      "predicate": {"rc.regexExtract": ["abc"]},
      "variables": {},
      "expected": {"error": "typeMismatch", "operator": "rc.regexExtract"}
    },
    {
      "id": "regex_extract_extra_operand_is_type_error",
      "predicate": {"rc.regexExtract": ["abc", "(a)", 1, 2]},
      "variables": {},
      "expected": {"error": "typeMismatch", "operator": "rc.regexExtract"}
    }
  ]
}

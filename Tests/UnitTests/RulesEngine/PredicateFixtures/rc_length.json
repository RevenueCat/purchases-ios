{
  "fixtures": [
    {
      "id": "length_empty_string_is_zero",
      "predicate": {
        "===": [
          {
            "rc.length": ""
          },
          0
        ]
      },
      "variables": {},
      "expected": true
    },
    {
      "id": "length_ascii_string_counts_characters",
      "predicate": {
        "===": [
          {
            "rc.length": "hello"
          },
          5
        ]
      },
      "variables": {},
      "expected": true
    },
    {
      "id": "length_string_uses_utf16_code_units_not_grapheme_clusters",
      "description": "Waving-hand emoji is one Swift grapheme cluster (.count == 1) but two UTF-16 code units, matching JS String.length",
      "predicate": {
        "===": [
          {
            "rc.length": "👋"
          },
          2
        ]
      },
      "variables": {},
      "expected": true
    },
    {
      "id": "length_empty_array_is_zero",
      "description": "Literal array operands must be wrapped: {\"rc.length\": [[]]}",
      "predicate": {
        "===": [
          {
            "rc.length": [
              []
            ]
          },
          0
        ]
      },
      "variables": {},
      "expected": true
    },
    {
      "id": "length_unwrapped_empty_array_is_type_error",
      "description": "An unwrapped empty array is an empty argument list, not a literal array operand",
      "predicate": {
        "rc.length": []
      },
      "variables": {},
      "expected": {
        "error": "typeMismatch",
        "operator": "rc.length"
      }
    },
    {
      "id": "length_array_counts_top_level_elements",
      "predicate": {
        "===": [
          {
            "rc.length": [
              [
                1,
                2,
                3
              ]
            ]
          },
          3
        ]
      },
      "variables": {},
      "expected": true
    },
    {
      "id": "length_array_does_not_recurse_into_nested_arrays",
      "predicate": {
        "===": [
          {
            "rc.length": [
              [
                [
                  1,
                  2
                ],
                3
              ]
            ]
          },
          2
        ]
      },
      "variables": {},
      "expected": true
    },
    {
      "id": "length_multi_element_arg_list_uses_first_only",
      "description": "json-logic-js spread semantics: only the first argument is used; extra args silently ignored. Treating the list as one array operand would instead yield 2",
      "predicate": {
        "===": [
          {
            "rc.length": [
              "abc",
              "ignored"
            ]
          },
          3
        ]
      },
      "variables": {},
      "expected": true
    },
    {
      "id": "length_null_is_type_error",
      "predicate": {
        "rc.length": null
      },
      "variables": {},
      "expected": {
        "error": "typeMismatch",
        "operator": "rc.length"
      }
    },
    {
      "id": "length_undefined_is_type_error",
      "predicate": {
        "rc.length": {
          "and": []
        }
      },
      "variables": {},
      "expected": {
        "error": "typeMismatch",
        "operator": "rc.length"
      }
    },
    {
      "id": "length_bool_is_type_error",
      "predicate": {
        "rc.length": true
      },
      "variables": {},
      "expected": {
        "error": "typeMismatch",
        "operator": "rc.length"
      }
    },
    {
      "id": "length_number_is_type_error",
      "predicate": {
        "rc.length": 42
      },
      "variables": {},
      "expected": {
        "error": "typeMismatch",
        "operator": "rc.length"
      }
    },
    {
      "id": "length_object_is_type_error",
      "description": "Objects are literal data only with multiple keys; use var to supply a single-key object as the operand",
      "predicate": {
        "rc.length": {
          "var": "obj"
        }
      },
      "variables": {
        "obj": {
          "a": 1
        }
      },
      "expected": {
        "error": "typeMismatch",
        "operator": "rc.length"
      }
    },
    {
      "id": "length_missing_variable_fails_at_the_lookup",
      "description": "the missing key is caught by var before rc.length ever sees it, so the error names the unresolved path rather than blaming the operator for a null argument",
      "predicate": {
        "rc.length": {
          "var": "missing"
        }
      },
      "variables": {},
      "expected": {
        "error": "unresolvedVariable",
        "path": "missing"
      }
    },
    {
      "id": "length_explicit_null_is_still_a_type_error",
      "description": "a key that is present but null is a known value, not an unresolved one, so it reaches rc.length and fails there instead",
      "predicate": {
        "rc.length": {
          "var": "maybe"
        }
      },
      "variables": {
        "maybe": null
      },
      "expected": {
        "error": "typeMismatch",
        "operator": "rc.length"
      }
    },
    {
      "id": "length_supports_arithmetic_comparison_on_array",
      "description": "Motivating case: compare array length directly without a reduce counter",
      "predicate": {
        ">": [
          {
            "rc.length": {
              "var": "tags"
            }
          },
          2
        ]
      },
      "variables": {
        "tags": [
          "a",
          "b",
          "c"
        ]
      },
      "expected": true
    }
  ]
}

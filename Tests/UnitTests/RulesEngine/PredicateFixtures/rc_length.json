{
  "fixtures": [
    {
      "id": "length_empty_string_is_zero",
      "predicate": {
        "===": [
          {
            "rc.length": ""
          },
          0
        ]
      },
      "variables": {},
      "expected": true
    },
    {
      "id": "length_ascii_string_counts_characters",
      "predicate": {
        "===": [
          {
            "rc.length": "hello"
          },
          5
        ]
      },
      "variables": {},
      "expected": true
    },
    {
      "id": "length_string_uses_utf16_code_units_not_grapheme_clusters",
      "description": "Waving-hand emoji is one Swift grapheme cluster (.count == 1) but two UTF-16 code units, matching JS String.length",
      "predicate": {
        "===": [
          {
            "rc.length": "👋"
          },
          2
        ]
      },
      "variables": {},
      "expected": true
    },
    {
      "id": "length_empty_array_is_zero",
      "description": "Literal array operands must be wrapped: {\"rc.length\": [[]]}",
      "predicate": {
        "===": [
          {
            "rc.length": [
              []
            ]
          },
          0
        ]
      },
      "variables": {},
      "expected": true
    },
    {
      "id": "length_array_counts_top_level_elements",
      "predicate": {
        "===": [
          {
            "rc.length": [
              [
                1,
                2,
                3
              ]
            ]
          },
          3
        ]
      },
      "variables": {},
      "expected": true
    },
    {
      "id": "length_array_does_not_recurse_into_nested_arrays",
      "predicate": {
        "===": [
          {
            "rc.length": [
              [
                [
                  1,
                  2
                ],
                3
              ]
            ]
          },
          2
        ]
      },
      "variables": {},
      "expected": true
    },
    {
      "id": "length_null_is_type_error",
      "predicate": {
        "rc.length": null
      },
      "variables": {},
      "expected": {
        "error": "typeMismatch",
        "operator": "rc.length"
      }
    },
    {
      "id": "length_undefined_is_type_error",
      "predicate": {
        "rc.length": {
          "and": []
        }
      },
      "variables": {},
      "expected": {
        "error": "typeMismatch",
        "operator": "rc.length"
      }
    },
    {
      "id": "length_bool_is_type_error",
      "predicate": {
        "rc.length": true
      },
      "variables": {},
      "expected": {
        "error": "typeMismatch",
        "operator": "rc.length"
      }
    },
    {
      "id": "length_number_is_type_error",
      "predicate": {
        "rc.length": 42
      },
      "variables": {},
      "expected": {
        "error": "typeMismatch",
        "operator": "rc.length"
      }
    },
    {
      "id": "length_object_is_type_error",
      "description": "Objects are literal data only with multiple keys; use var to supply a single-key object as the operand",
      "predicate": {
        "rc.length": {
          "var": "obj"
        }
      },
      "variables": {
        "obj": {
          "a": 1
        }
      },
      "expected": {
        "error": "typeMismatch",
        "operator": "rc.length"
      }
    },
    {
      "id": "length_missing_variable_is_type_error",
      "description": "var resolves a missing key to null; rc.length throws rather than silently returning 0",
      "predicate": {
        "rc.length": {
          "var": "missing"
        }
      },
      "variables": {},
      "expected": {
        "error": "typeMismatch",
        "operator": "rc.length"
      }
    },
    {
      "id": "length_supports_arithmetic_comparison_on_array",
      "description": "Motivating case: compare array length directly without a reduce counter",
      "predicate": {
        ">": [
          {
            "rc.length": {
              "var": "tags"
            }
          },
          2
        ]
      },
      "variables": {
        "tags": [
          "a",
          "b",
          "c"
        ]
      },
      "expected": true
    }
  ]
}
